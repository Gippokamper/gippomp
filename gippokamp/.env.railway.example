# ============================================================
#  Railway'ga qo'yiladigan environment o'zgaruvchilari
#  (Railway → loyiha → Variables bo'limiga kiritiladi)
# ============================================================

APP_NAME=Gippokamp
APP_ENV=production
APP_DEBUG=false
# APP_KEY ni bo'sh qoldiring — birinchi ishga tushishда o'zi yaratiladi,
# yoki lokalда `php artisan key:generate --show` bilan yaratib, shu yerga qo'ying:
APP_KEY=
APP_URL=https://api.gippokamp.uz

LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Ma'lumotlar bazasi (Railway MySQL plaginidan) ---
# Railway'да MySQL qo'shsangiz, quyidagilarni "Reference" orqali bog'lang:
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# --- Session / Cache / Queue (fayl asosida — sodda) ---
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
FILESYSTEM_DISK=public

# --- To'lov tizimlari ---
PAYME_KEY=
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=
APELSIN_KEY=
UPAY_KEY=

# --- SMS ---
SMS_URL=http://sms.etc.uz:8084/json2sms
SMS_LOGIN=
SMS_PASSWORD=
SMS_SENDER=Gippokamp

# --- Firebase (push) ---
FCM_SERVER_KEY=

# --- Mail (ixtiyoriy) ---
MAIL_MAILER=log
