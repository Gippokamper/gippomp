# ---------------------------------------------------------------------------
# Maxfiy ma'lumot — HECH QACHON repozitoriyga tushmasin
# ---------------------------------------------------------------------------
# .env ichida Payme/Click/Apelsin kalitlari, FCM server kaliti, SMS provayder
# login/paroli va Laravel APP_KEY bor.
# (Yo'lsiz naqsh git'da istalgan chuqurlikda ishlaydi.)
.env
.env.local
.env.*.local
!.env.example
!.env.railway.example

# Baza dumplari — real foydalanuvchilar ma'lumoti (telefon, email, tug'ilgan
# sana, to'lovlar tarixi). Repozitoriy ochiq bo'lgani uchun bu ayniqsa muhim.
*.sql
*.sql.gz
*.dump
**/database/database.sqlite

# ---------------------------------------------------------------------------
# Kontent (kod emas) — prod serverda bor, repoga kerak emas
# ---------------------------------------------------------------------------
/media/
**/public/image/
**/storage/app/public/*
**/public/storage

# ---------------------------------------------------------------------------
# Bog'lanmalar va build natijalari
# ---------------------------------------------------------------------------
node_modules/
vendor/
build/
dist/
.pnp
.pnp.js

# ---------------------------------------------------------------------------
# Laravel ish vaqti fayllari
# ---------------------------------------------------------------------------
# DIQQAT: `**/` shart. Yo'l ichida `/` bo'lgan naqsh .gitignore turgan
# papkaga bog'lanadi, ya'ni `storage/logs/*.log` faqat ildizdagi storage'ga
# tegardi va `gippokamp/storage/logs` ochiq qolardi (27 MB log).
**/storage/logs/*.log
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/storage/framework/testing/*
**/bootstrap/cache/*.php

# ---------------------------------------------------------------------------
# IDE / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
__MACOSX/
*.swp

# ---------------------------------------------------------------------------
# Log / coverage
# ---------------------------------------------------------------------------
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
